<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Career Profile Check | ESP Toolkit</title><style>
:root{--pine:#006d6a;--dark:#004c49;--green:#b6ddc0;--amber:#ffb21c;--ink:#162c3a;--muted:#415765;--line:#cadbd7;--bg:#f3f8f7}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 Arial,sans-serif}button,textarea{font:inherit}button,summary{cursor:pointer}button,a,textarea,summary{outline-offset:4px}button:focus-visible,a:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #a94b00}button{border:1px solid var(--line);border-radius:10px;padding:11px 16px;background:white;color:var(--dark);font-weight:700}button:hover{border-color:var(--pine)}.primary,button[aria-pressed=true]{background:var(--pine);color:white;border-color:var(--pine)}header{background:var(--pine);color:white;border-bottom:7px solid var(--green);padding:40px max(24px,calc((100vw - 1120px)/2))}header h1{font-size:clamp(2.3rem,5vw,3.5rem);line-height:1.1;letter-spacing:-.04em;margin:13px 0}header p{max-width:740px;font-size:1.1rem;margin-bottom:0}.eyebrow{font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;font-weight:800}main{max-width:1168px;padding:26px 24px 60px;margin:auto}.flow{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:24px;color:var(--dark);font-size:.9rem;font-weight:700}.flow span{background:#e5f3ef;padding:9px 16px;border-radius:8px}.intro{background:#fff1dc;border:1px solid #f2c785;border-radius:14px;padding:18px 22px}.intro p{margin:4px 0}.layout{display:grid;grid-template-columns:260px 1fr;gap:24px;margin-top:26px}nav{align-self:start;position:sticky;top:18px}nav button{display:block;width:100%;text-align:left;margin-bottom:9px;padding:16px}nav small{display:block;font-weight:400;margin:4px 0 0}.num{font-size:.8rem;opacity:.85;display:block}.panel{background:white;border:1px solid var(--line);border-radius:18px;padding:28px}h2{font-size:1.8rem;line-height:1.2;margin:8px 0 12px;letter-spacing:-.025em}h3{line-height:1.4;font-size:1.1rem}.sub{color:var(--muted);margin-top:0}.question{border-top:1px solid var(--line);padding:22px 0}.question h3{margin:0 0 8px}.question p{margin:7px 0 15px;color:var(--muted)}.choices{display:flex;gap:8px;flex-wrap:wrap}.feedback{background:#eaf5f1;padding:12px 15px;border-radius:9px;margin-top:12px}.feedback.attention{background:#fff1dc;border-left:4px solid var(--amber)}details{border:1px solid var(--line);border-radius:12px;padding:15px 18px;background:#f3f8f7;margin:12px 0 24px}summary{color:var(--dark);font-weight:700}.example{border-left:4px solid var(--pine);padding:0 16px;margin-top:18px}.example li{margin:8px 0}.label{display:block;font-weight:700;margin:8px 0}textarea{display:block;width:100%;min-height:95px;border:1px solid #799f98;border-radius:10px;padding:12px;color:var(--ink)}.bottom,.toolbar{display:flex;gap:10px;flex-wrap:wrap;justify-content:space-between;margin-top:24px}.progress{background:#dbe9e5;border-radius:20px;height:7px;margin:16px 0 7px}.progress div{height:100%;background:var(--pine);border-radius:20px}.small{font-size:.85rem;color:var(--muted)}.summary-card{border-top:1px solid var(--line);padding:18px 0}.pill{font-size:.8rem;background:#fff1dc;padding:4px 9px;border-radius:7px;display:inline-block}.skip{position:absolute;left:-9999px}.skip:focus{left:10px;top:10px;background:white;padding:10px}.hidden{display:none!important}.printonly{display:none}footer{margin-top:26px;color:var(--muted);font-size:.85rem}@media(max-width:780px){.layout{grid-template-columns:1fr}nav{position:static;display:grid;grid-template-columns:1fr 1fr;gap:8px}nav button{margin:0}.panel{padding:20px}main{padding:20px 16px}.flow{gap:6px}.flow span{padding:8px;font-size:.8rem}}@media print{header{background:white;color:black;padding:0;border-bottom:2px solid black}header h1{font-size:26pt}main{padding:0}.flow,.intro,nav,#detail,.toolbar,footer,.screenonly{display:none!important}.layout{display:block}.panel{border:0;padding:0}#summary{display:block!important}.printonly{display:block}.summary-card{break-inside:avoid}.small{color:black}button{display:none}}
input,select{font:inherit;padding:10px;border:1px solid #799f98;border-radius:8px;max-width:100%}.controlrow{display:flex;align-items:end;gap:12px;flex-wrap:wrap}.controlrow label{display:grid;gap:5px}.tablewrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:.88rem}th,td{text-align:left;border:1px solid var(--line);padding:10px;vertical-align:top}th{background:#e5f3ef}.state-attention{background:#fff1dc}.state-checked{background:#eaf5f1}.overview-note{white-space:pre-wrap}.overview-help{margin:12px 0}#caseloadControls{margin-top:24px}.fieldhint{font-size:.9rem;color:var(--muted)}@media print{#saveStatus,#caseloadControls{display:none!important}table{font-size:8pt}th,td{padding:5px}.tablewrap{overflow:visible}.hidden{display:none!important}#summary{display:block!important}}
#content{min-width:0}td button{font-size:.85rem;padding:6px 8px;text-align:left}@media print{td button{display:inline!important;border:0;padding:0;color:black;background:transparent;font-weight:400}}
/* Keep the review itself in focus. */
header{padding:22px max(24px,calc((100vw - 1120px)/2))}header h1{font-size:clamp(2rem,4vw,2.7rem);margin:7px 0}header p{font-size:1rem;margin:8px 0 0}main{padding-top:16px}.quickstart{margin:0 0 14px;color:var(--muted)}#caseloadControls{padding:16px 20px;margin-top:0;border-radius:12px}.controlrow{align-items:center;gap:10px}.controlrow>label:first-child{display:flex;align-items:center;gap:10px}.options{margin:10px 0 0;padding:0;border:0;background:transparent}.options>summary{font-size:.88rem;font-weight:600}.options[open]>.controlrow{margin-top:14px}.options p{margin-bottom:0}#saveStatus{margin:7px 0;font-size:.8rem}.layout{margin-top:16px;grid-template-columns:235px 1fr}.panel{padding:24px}nav button{padding:10px 14px}nav .num{display:inline;margin-right:8px}nav small{margin-left:25px;font-size:.78rem}.progress{margin:8px 0 18px;height:5px}.sub{font-size:.95rem}.question{padding:18px 0}.guidance{border:0;background:transparent;border-radius:0;padding:0;margin:6px 0 12px}.guidance summary{font-size:.88rem;font-weight:600}.guidance p{border-left:3px solid var(--line);padding-left:12px;margin-top:10px}.examples-group{padding:14px 0 20px;border-top:1px solid var(--line)}.example-toggle{margin:8px 0;padding:10px 14px;border-radius:8px}.example-toggle summary{font-size:.95rem}.example{margin-top:12px}.note-guidance{margin-bottom:10px}.feedback{padding:9px 12px;font-size:.92rem}.choices button{padding:9px 13px}.choices button:last-child:not([aria-pressed]){border-color:transparent;font-weight:400;font-size:.85rem}textarea{min-height:110px}
@media(max-width:780px){.layout{grid-template-columns:1fr}nav{grid-template-columns:repeat(2,minmax(0,1fr))}nav button{padding:9px}nav small{margin-left:0}.controlrow>label:first-child{flex-wrap:wrap}#caseloadControls{padding:14px}.panel{padding:18px}}@media print{header{padding:0}.layout{display:block}.quickstart{display:none}}
.landing{display:block}.landing nav{position:static;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.landing nav button{min-height:86px;margin:0;padding:17px}.landing nav button:nth-last-child(-n+2){min-height:55px}.example-toggle{border:2px solid #b7730c;background:#fff1dc;padding:0;overflow:hidden}.example-toggle>summary{font-weight:800;font-size:1rem;padding:14px 18px;color:#663d00}.example-toggle>summary:hover{background:#ffe3ad}.example-toggle[open]>summary{border-bottom:1px solid #d5ad6d}.example-toggle .example{margin:16px 18px;border-left-color:#b7730c}.examples-group{padding-top:8px}.landing nav button:hover{background:#e5f3ef}@media(max-width:780px){.landing nav{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:450px){.landing nav{grid-template-columns:1fr}.landing nav button{min-height:65px}}
:root{--pine:#245B57;--dark:#183E3B;--green:#DDEDDC;--amber:#C66A1B;--ink:#243238;--muted:#4B5B60;--line:#CED8D3;--bg:#F7F8F4;--orange:#A54508}body{background:var(--bg);color:var(--ink)}.panel{background:#FFFFFF}header{border-bottom-color:#DDEDDC}.guidance>summary,.note-guidance>summary{color:var(--orange);font-weight:800}.guidance>summary:hover{text-decoration:underline}.example-toggle{background:#EAF4E6;border-color:#C66A1B}.example-toggle>summary{color:#243238}.example-toggle>summary:hover{background:#DDEDDC}.example-toggle[open]>summary{border-bottom-color:#C66A1B}.example-toggle .example{border-left-color:#C66A1B}.example blockquote{margin:12px 0;padding:12px 16px;background:#FFFFFF;border-left:3px solid #8DAE8D;color:#243238}.review-links{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:18px;grid-column:1/-1}.review-links button{width:auto;text-align:center;min-height:0!important;padding:12px 18px!important;margin:0}.layout:not(.landing) .review-links{display:flex;flex-direction:column;align-items:center}.layout:not(.landing) .review-links button{width:100%}.landing .review-links button{min-width:220px}.landing nav>button:nth-last-child(-n+2){min-height:86px}.example-toggle>summary:focus-visible,.guidance>summary:focus-visible{outline:3px solid #A54508}.state-attention{background:#FFF0DC}.state-checked{background:#EAF4E6}@media(max-width:450px){.landing .review-links button{min-width:0;width:100%}}
.identifier-field{display:grid;gap:4px;font-weight:700}.identifier-field input{width:220px;background:#F4FAF1;border:2px solid #6D8E75}.identifier-help{margin:8px 0 12px}.file-controls{display:flex;gap:10px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:12px}.file-controls button{padding:8px 12px;font-size:.9rem}.file-help{margin-bottom:0;max-width:880px}@media(max-width:600px){.identifier-field{width:100%}.identifier-field input{width:100%}}
.review-picker{display:inline-flex}.review-picker input{width:250px;background:#FFFFFF;border:1px solid #799f98;font-weight:600}.review-picker input:focus{outline:3px solid #A54508;outline-offset:3px}@media(max-width:450px){.review-picker input{width:100%}.review-picker{min-width:0}}
</style></head><body><a href="#content" class="skip">Skip to review</a><header><div class="eyebrow">IPS Employment Specialist Toolkit</div><h1>Career Profile Check</h1><p>Review the profile. Flag updates. Keep track of next steps.</p></header><main><p class="quickstart screenonly">Keep the Career Profile open beside you. Check each area and note what needs updating.</p><section class="panel screenonly" id="caseloadControls"></section><p id="saveStatus" class="small screenonly" role="status"></p><div class="layout"><nav id="nav" aria-label="Review areas"></nav><div id="content"><div class="screenonly"><strong id="progressText" aria-live="polite"></strong><div class="progress"><div id="bar"></div></div></div><section class="panel" id="detail"></section><section class="panel hidden" id="summary"></section></div></div></main><script>
const areas=[{"title": "Input from others", "sub": "Bring together the person’s perspective and useful input from their supports.", "questions": [["Does the Career Profile include meaningful input from others?", "Look for input from a therapist, prescriber, EIPD counselor, family member, partner, friend, or any other person the individual would like to have provide input. Remember: just putting in a person’s name does not show their input.", "With the person, identify who could share useful information. Document who provided input, when, what was learned, and how it informs employment supports."]], "example": "<p><strong>Example 1:</strong> 11/1/2026 CST therapist noted that Charlie responds well to deep breathing techniques when he is feeling anxious.</p><p><strong>Example 2:</strong> OPT Therapist Kara Reed noted that practicing unfamiliar conversations ahead of time helps Charlie feel prepared and that he would respond well to preparing for conversations with his managers.</p><p><strong>Example 3:</strong> UPDATE: 11/4/2026 – Sister Katie noted that Jordan has been expressing frustrations about his job and feels he may need help talking with his manager about what is expected of him at work.</p>", "prompt": "Who could be contacted to add input? Is there input from clinical meetings that has not been added? Is there information from family, friends, EIPD, or others that has not been added?", "exampleGroups": [["Examples", "<p><strong>Example 1:</strong> 11/1/2026 CST therapist noted that Charlie responds well to deep breathing techniques when he is feeling anxious.</p><p><strong>Example 2:</strong> OPT Therapist Kara Reed noted that practicing unfamiliar conversations ahead of time helps Charlie feel prepared and that he would respond well to preparing for conversations with his managers.</p><p><strong>Example 3:</strong> UPDATE: 11/4/2026 – Sister Katie noted that Jordan has been expressing frustrations about his job and feels he may need help talking with his manager about what is expected of him at work.</p>"]]}, {"title": "Pertinent updates", "sub": "Keep the profile connected to what is happening in the person’s life and work.", "questions": [["Does the Career Profile reflect pertinent changes?", "Check for updates when job goals change, a job starts or ends, disclosure preferences change, input from others is added, symptoms change, or new coping skills are learned. Just adding a date followed by “no changes” is not really an update. Provide specific information.", "Review recent conversations and progress notes with the person. Add the relevant changes, date them, and describe what they mean for the job search or support plan."]], "example": "<p><strong>What to look for:</strong></p><ul><li><strong>Job goal changes:</strong> New interests, preferred hours, work setting, or tasks.</li><li><strong>Job starts:</strong> Employer, role, schedule, expectations, and initial support needs.</li><li><strong>Job ends:</strong> What the person learned and wants for their next job.</li><li><strong>Disclosure changes:</strong> Updated preferences and specific permission.</li><li><strong>New input:</strong> Useful information from the person’s chosen supports.</li><li><strong>Symptoms or coping skills change:</strong> Effects on work and strategies the person wants to use.</li></ul><p><strong>Example update:</strong> UPDATE – 11/1/26 ESP EE – Charlie has decided to add retail work to his career goal and is now open to looking for sales associate jobs in clothing stores.</p>", "prompt": "Does the job goal match the work being done with the person? Is the disclosure preference current? Are relevant changes documented with specific information? Has the Job Support Plan been updated after the job start?", "exampleGroups": [["Examples", "<p><strong>What to look for:</strong></p><ul><li><strong>Job goal changes:</strong> New interests, preferred hours, work setting, or tasks.</li><li><strong>Job starts:</strong> Employer, role, schedule, expectations, and initial support needs.</li><li><strong>Job ends:</strong> What the person learned and wants for their next job.</li><li><strong>Disclosure changes:</strong> Updated preferences and specific permission.</li><li><strong>New input:</strong> Useful information from the person’s chosen supports.</li><li><strong>Symptoms or coping skills change:</strong> Effects on work and strategies the person wants to use.</li></ul><p><strong>Example update:</strong> UPDATE – 11/1/26 ESP EE – Charlie has decided to add retail work to his career goal and is now open to looking for sales associate jobs in clothing stores.</p>"]]}, {"title": "Work history", "sub": "Use past work experiences to identify preferences and lessons learned.", "questions": [["Has work history been filled out and updated with new jobs, including the person’s favorite and least favorite jobs, if relevant?", "Look for more than job titles and dates. Include what the person liked and disliked about these jobs.", "Complete missing work history and add new jobs. Include favorite and least favorite jobs, if relevant."], ["Does work history include useful information for identifying preferences?", "Look for preferred tasks, schedules, settings, supervision, coworker interactions, and what made a job a good or poor fit.", "Add specific details that help guide the current job search and supports."], ["After a job loss, are lessons learned documented?", "Look for what worked, what was difficult, and what the person wants to do differently next time. Choose “Not applicable” if there has not been a job loss to review.", "Add what was learned after the job ended and how it informs the next job goal or support plan."]], "example": "<p><strong>What was liked about the tasks:</strong> “I liked stocking at the grocery store because I could move around and knew what needed to be done. My supervisor showed me each task before I tried it.”</p><p><strong>What was not liked about the schedule:</strong> “At the restaurant, the schedule changed every week.”</p><p><strong>Lessons learned after a job loss:</strong> “Next time, I want a more predictable schedule. I also want to practice asking for help before I get overwhelmed.”</p>", "prompt": "If relevant, are the person’s favorite and least favorite jobs included? Has work history been updated with new jobs? Are likes, dislikes, and lessons learned after a job loss documented in a way that helps identify preferences?", "exampleGroups": [["Examples", "<p><strong>What was liked about the tasks:</strong> “I liked stocking at the grocery store because I could move around and knew what needed to be done. My supervisor showed me each task before I tried it.”</p><p><strong>What was not liked about the schedule:</strong> “At the restaurant, the schedule changed every week.”</p><p><strong>Lessons learned after a job loss:</strong> “Next time, I want a more predictable schedule. I also want to practice asking for help before I get overwhelmed.”</p>"]]}, {"title": "Disclosure", "sub": "Make the person’s choices clear, specific, and individualized.", "questions": [["Are at least two individualized pros and two individualized cons documented?", "The discussion should connect to this person’s job goals, experiences, and concerns. “I don’t see any cons” does not count as an individualized con.", "Explore possible benefits and concerns together. Document the person’s perspective on at least two of each without inventing concerns or pressuring them to disclose."], ["Is the person’s disclosure preference clear: full, partial, or none?", "Look for a clear current choice in the person’s own terms, including what that choice means to them.", "Ask what the person wants an employer to know, if anything. Record full, partial, or no disclosure and revisit the choice when preferences change."], ["If the person wants disclosure, are there specific examples of what can and cannot be said?", "“Say anything, I’m an open book” does not show that specific examples were reviewed. For full disclosure, document examples you discussed to confirm the person is truly comfortable with full disclosure. Choose “Not applicable” if the person currently wants no disclosure.", "Write examples of approved language and information that should not be shared. Clarify who may share it, with whom, and when."]], "example": "<p><strong>Pros:</strong> “I would have help advocating for myself.” “They would know how to help when I am feeling anxious.”</p><p><strong>Cons:</strong> “My managers might not think I am capable of doing certain parts of the job.” “My coworkers may think I need special treatment or judge me.”</p><p><strong>Specifics for partial disclosure:</strong> “You can tell them I have a great work ethic and that you are my job coach. You can say you are there to support me if I have anxiety on the job and will be available to help make sure things go well. Do not tell them I was hospitalized last year, what my diagnosis is, or what medications I take. Also, do not tell them anything about my personal life with my husband.”</p><p><strong>When the person sees no cons:</strong> The person said they did not see any cons to disclosing. The ESP explained possible concerns, such as stigma or the possibility of being passed over for a position. The ESP explored how those possibilities might affect the person and documented their response.</p><p><strong>Exploring full disclosure:</strong> The ESP discussed specific examples of information that could be shared, including diagnosis, medications, past hospitalization, and personal circumstances. The person continued to choose full disclosure, stating, “I want to be honest about what I have been through. I am okay with you sharing that information.” The ESP documented the examples reviewed and the person’s current choice.</p><p><strong>No disclosure:</strong> “I don’t want my employer to know that I work with an employment specialist or that I receive any mental health services. My privacy is very important to me.”</p>", "prompt": "Is the person’s most recent disclosure preference clear? Are at least two examples of individualized pros and two examples of individualized cons documented? Are specifics about what can and cannot be said included? Have their preferences been updated for a new job?", "exampleGroups": [["Pros and cons", "<p><strong>Pros:</strong> “I would have help advocating for myself.” “They would know how to help when I am feeling anxious.”</p><p><strong>Cons:</strong> “My managers might not think I am capable of doing certain parts of the job.” “My coworkers may think I need special treatment or judge me.”</p>"], ["Specifics", "<p><strong>Specifics for partial disclosure:</strong> “You can tell them I have a great work ethic and that you are my job coach. You can say you are there to support me if I have anxiety on the job and will be available to help make sure things go well. Do not tell them I was hospitalized last year, what my diagnosis is, or what medications I take. Also, do not tell them anything about my personal life with my husband.”</p>"], ["When no cons are identified", "<p><strong>Example of what the ESP could write in the Career Profile:</strong></p><blockquote>The person said they did not see any cons to disclosing. The ESP explained possible concerns, such as stigma or the possibility of being passed over for a position. The ESP explored how those possibilities might affect the person and documented their response.</blockquote>"], ["Full disclosure", "<p><strong>Example of what the ESP could write in the Career Profile:</strong></p><blockquote>The ESP discussed specific examples of information that could be shared, including diagnosis, medications, past hospitalization, and personal circumstances. The person continued to choose full disclosure, stating, “I want to be honest about what I have been through. I am okay with you sharing that information.” The ESP documented the examples reviewed and the person’s current choice.</blockquote>"], ["No disclosure", "<p><strong>No disclosure:</strong> “I don’t want my employer to know that I work with an employment specialist or that I receive any mental health services. My privacy is very important to me.”</p>"]]}, {"title": "Job Search Plan", "sub": "Connect the job goal to real applications, employer contacts, and agreed supports.", "questions": [["Is the job goal specific and reflected in applications and job development?", "Check whether the type of work, preferred setting, and other important preferences match the jobs being pursued. “To find stable employment and a job that will support my family” is not a specific job goal. Name the type of work and relevant preferences.", "Clarify the person’s current goal together. Align applications and employer contacts with that goal, or document the person’s interest in exploring a new option."], ["Does the plan name specific places to apply?", "Look for named employers or locations that fit the person’s preferences, rather than “apply for jobs.”", "Identify specific employers with the person and document where they want to apply or have the ESP develop relationships."], ["Does the plan explain needed supports, who will provide them, and how?", "Look for individual needs and clear actions for the person, ESP, and any other agreed supports.", "For each need, record the support, who will provide it, how and where it will happen, and the agreed frequency or timeline."]], "example": "<p><strong>Job goal:</strong> “Since I am comfortable running a cash register and working with customers, I want to work part-time in a sales associate or stocking position in a store that is on the bus route or within walking distance of my home.”</p><p><strong>Skills and tasks needed:</strong> Filling out online applications.</p><p><strong>Job Seeker:</strong> Jordan will meet with the ESP at the library every Tuesday. Jordan will have identified two places to apply online.</p><p><strong>IPS Team:</strong> The ESP will assist Jordan in filling out applications, teaching him what information is needed in each section. The ESP will provide guidance and feedback so Jordan can learn how to complete applications on his own.</p><p><strong>Skills and tasks needed:</strong> Planning transportation to potential workplaces.</p><p><strong>Job Seeker:</strong> Jordan will identify the bus routes or walking routes to two stores of interest and bring any questions to his weekly meeting with the EPM.</p><p><strong>IPS Team:</strong> The EPM will review routes and travel times with Jordan and practice using the bus schedule. If needed, the EPM will travel the route with him so he can learn how to get to interviews and work independently.</p>", "prompt": "Is the job goal up to date? Does it match the applications and job development? Are specific places to apply listed? Are the skills the person needs help with listed, along with who will help and how support will be provided?", "exampleGroups": [["Job goal", "<p><strong>Job goal:</strong> “Since I am comfortable running a cash register and working with customers, I want to work part-time in a sales associate or stocking position in a store that is on the bus route or within walking distance of my home.”</p>"], ["Online application support", "<p><strong>Skills and tasks needed:</strong> Filling out online applications.</p><p><strong>Job Seeker:</strong> Jordan will meet with the ESP at the library every Tuesday. Jordan will have identified two places to apply online.</p><p><strong>IPS Team:</strong> The ESP will assist Jordan in filling out applications, teaching him what information is needed in each section. The ESP will provide guidance and feedback so Jordan can learn how to complete applications on his own.</p>"], ["Transportation support", "<p><strong>Skills and tasks needed:</strong> Planning transportation to potential workplaces.</p><p><strong>Job Seeker:</strong> Jordan will identify the bus routes or walking routes to two stores of interest and bring any questions to his weekly meeting with the EPM.</p><p><strong>IPS Team:</strong> The EPM will review routes and travel times with Jordan and practice using the bus schedule. If needed, the EPM will travel the route with him so he can learn how to get to interviews and work independently.</p>"]]}, {"title": "Job Support Plan", "sub": "Turn the person’s experience on the job into a clear plan for ongoing support.", "questions": [["Does the plan explain needed supports, who will provide them, and how?", "Look for supports tied to this person’s job and preferences, including agreed natural supports, EIPD, or behavioral health supports when relevant.", "Discuss what is going well and where support would help. Name the support, responsible person, method, location, and frequency."], ["Was the plan updated promptly after the job started?", "Try to update the plan within 30 days of a job start, or sooner, to individualize it for the new job and the specific supports the person may need.", "Compare the job start date with the plan update date. Review the job, expectations, support needs, and preferences with the person and update the plan."]], "example": "<p><strong>Example 1 · Initial goal / support need:</strong> “I may need help talking to my manager about getting days or times off to attend therapy. I often feel like I will get in trouble for asking.”</p><p><strong>Job support:</strong> The ESP will meet with Jordan weekly in the community to review his schedule and role-play how to ask his manager for days or times off to attend therapy when he needs it.</p><p><strong>Example 2 · Job Support Plan update after job start:</strong> UPDATE: 11/02/2026 by ESP EE for job at Target – Jordan has a set schedule that includes working on the days he meets with his therapist. The ESP will assist Jordan in talking with his therapist to see if his weekly appointment time can be moved. If this is not an option, the ESP will role-play with Jordan how to talk with his manager about switching his scheduled days and times.</p><p><strong>Additional update with input from others:</strong> UPDATE: 11/6/2026 for job start at Target – OPT Therapist noted that since Jordan will be working during the busy holiday season, if he starts to get overwhelmed, encourage him to take deep breaths and count backward from 10, as this has been a successful calming tool for him.</p>", "prompt": "Are there updates after the job start? Do they reflect the person’s actual job and support needs? Who besides the IPS team can be included in these supports?", "exampleGroups": [["Initial support plan", "<p><strong>Example 1 · Initial goal / support need:</strong> “I may need help talking to my manager about getting days or times off to attend therapy. I often feel like I will get in trouble for asking.”</p><p><strong>Job support:</strong> The ESP will meet with Jordan weekly in the community to review his schedule and role-play how to ask his manager for days or times off to attend therapy when he needs it.</p>"], ["Update after job start", "<p><strong>Example 2 · Job Support Plan update after job start:</strong> UPDATE: 11/02/2026 by ESP EE for job at Target – Jordan has a set schedule that includes working on the days he meets with his therapist. The ESP will assist Jordan in talking with his therapist to see if his weekly appointment time can be moved. If this is not an option, the ESP will role-play with Jordan how to talk with his manager about switching his scheduled days and times.</p>"], ["Update with therapist input", "<p><strong>Additional update with input from others:</strong> UPDATE: 11/6/2026 for job start at Target – OPT Therapist noted that since Jordan will be working during the busy holiday season, if he starts to get overwhelmed, encourage him to take deep breaths and count backward from 10, as this has been a successful calming tool for him.</p>"]]}];
const labels={yes:'Yes',attention:'Needs attention',na:'Not applicable'},KEY='esp-career-check-v2';
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const total=areas.reduce((n,a)=>n+a.questions.length,0);let charts=[],active=0,current=-1;
function blank(n){return {label:'Chart '+n,answers:{},notes:{},updated:''};}
function validate(data){if(!data||![2,3].includes(data.version)||!Array.isArray(data.charts)||data.charts.length<1||data.charts.length>25)throw Error('Choose a saved Career Profile reviews file with 1–25 charts.');return data.charts.map(original=>{let c=original;if(data.version===2&&original&&original.answers&&original.notes){const mapIndex=i=>i===1?2:i===2?1:i;const answers={},notes={};for(const [k,v] of Object.entries(original.answers)){const [i,j]=k.split('-').map(Number);answers[mapIndex(i)+'-'+j]=v;}for(const [k,v] of Object.entries(original.notes))notes[mapIndex(Number(k))]=v;c={...original,answers,notes};}if(typeof c.label!=='string'||!c.answers||!c.notes)throw Error('This reviews file has an invalid chart.');let out={label:c.label.slice(0,80),answers:{},notes:{},updated:typeof c.updated==='string'?c.updated:''};areas.forEach((a,i)=>{a.questions.forEach((q,j)=>{let k=i+'-'+j;if(c.answers[k]!==undefined){if(!labels[c.answers[k]])throw Error('This reviews file has an invalid answer.');out.answers[k]=c.answers[k];}});if(c.notes[i]!==undefined){if(typeof c.notes[i]!=='string')throw Error('This reviews file has invalid notes.');out.notes[i]=c.notes[i];}});return out;});}
let storageError='';try{const saved=localStorage.getItem(KEY);if(saved)charts=validate(JSON.parse(saved));}catch(e){storageError='Saved reviews could not be loaded. Use “Restore reviews from a file” to recover a saved copy.';}if(!charts.length)charts=[blank(1)];
function chart(){return charts[active];}function persist(){chart().updated=new Date().toLocaleString();try{localStorage.setItem(KEY,JSON.stringify({version:3,charts}));document.getElementById('saveStatus').textContent='Saved in this browser. Last change: '+chart().updated;}catch(e){document.getElementById('saveStatus').textContent='This browser could not save your reviews. Use “Save reviews to a file” before closing this page.';}}
function controls(){document.getElementById('caseloadControls').innerHTML=`<div class="controlrow"><label>Reviewing<span class="review-picker"><input id="chartSelect" list="chartChoices" maxlength="80" value="${esc(chart().label)}" onchange="reviewingChanged(this.value)" aria-describedby="identifierHelp" autocomplete="off"><datalist id="chartChoices">${charts.map(c=>`<option value="${esc(c.label)}"></option>`).join('')}</datalist></span></label><button onclick="addChart()" ${charts.length===25?'disabled':''}>+ Add chart (${charts.length}/25)</button><button onclick="show(7,true)" class="primary">Caseload overview</button></div><p id="identifierHelp" class="small identifier-help">Replace “Chart 1” with initials or a code to recognize each review. Choose another saved chart from this same box.</p><div class="file-controls"><button onclick="saveReviews()">Save reviews to a file</button><button onclick="document.getElementById('importFile').click()">Restore reviews from a file</button><input class="hidden" type="file" id="importFile" accept=".json,application/json" onchange="importBackup(this.files[0])"></div><p class="small file-help">Reviews save automatically in this browser. Save a file to restore them later or move them to another browser or computer. The Excel download is for reading results and notes.</p>`;}

function reviewingChanged(value){const label=value.trim();const existing=charts.findIndex(c=>c.label===label);if(existing>=0&&existing!==active){switchChart(existing);}else{renameChart(label);}}
function renameChart(s){s=s.trim();if(!s){controls();return;}chart().label=s;persist();controls();show(current);}
function switchChart(i){active=i;controls();show(0,true);}
function addChart(){if(charts.length>=25)return;let n=1;while(charts.some(c=>c.label==='Chart '+n))n++;charts.push(blank(n));active=charts.length-1;persist();controls();show(0,true);}
function updateNav(){let c=chart();document.getElementById('nav').innerHTML=areas.map((a,i)=>`<button aria-pressed="${current===i}" onclick="show(${i},true)"><span class="num">0${i+1}</span>${a.title}<small>${a.questions.filter((q,j)=>c.answers[i+'-'+j]).length} of ${a.questions.length} checked</small></button>`).join('')+`<div class="review-links"><button aria-pressed="${current===6}" onclick="show(6,true)">This chart’s review →</button><button aria-pressed="${current===7}" onclick="show(7,true)">Caseload overview →</button></div>`;let n=Object.keys(c.answers).length;document.getElementById('progressText').textContent=c.label+': '+n+' of '+total+' questions checked';document.getElementById('bar').style.width=n/total*100+'%';}
function show(i,focus=false){current=i;updateNav();document.querySelector('.layout').classList.toggle('landing',i===-1);document.getElementById('content').classList.toggle('hidden',i===-1);if(i===-1){document.getElementById('detail').innerHTML='';document.getElementById('summary').innerHTML='';return;}document.getElementById('detail').classList.toggle('hidden',i>=6);document.getElementById('summary').classList.toggle('hidden',i<6);if(i===6)renderSummary();else if(i===7)renderOverview();else{const a=areas[i],c=chart();document.getElementById('detail').innerHTML=`<div class="eyebrow">${esc(c.label)} · Review area 0${i+1} / 06</div><h2 tabindex="-1">${a.title}</h2><p class="sub">${a.sub}</p>${a.questions.map((q,j)=>{let k=i+'-'+j;return `<div class="question"><h3 id="q${k}">${q[0]}</h3><details class="guidance"><summary>What to look for</summary><p>${q[1]}</p></details><div class="choices" role="group" aria-labelledby="q${k}">${Object.entries(labels).map(([v,l])=>`<button aria-pressed="${c.answers[k]===v}" onclick="answer('${k}','${v}')">${l}</button>`).join('')}<button onclick="clearAnswer('${k}')" aria-label="Clear answer for: ${q[0]}">Clear</button></div><div id="f${k}" aria-live="polite">${feedback(i,j)}</div></div>`}).join('')}<div class="examples-group">${a.exampleGroups.map(([title,body])=>`<details class="example-toggle"><summary>${title==='Examples'?'View examples':'Example: '+title}</summary><div class="example">${body}</div></details>`).join('')}</div><label class="label" for="note">What needs to be added or clarified?</label><details class="guidance note-guidance"><summary>Prompts to consider</summary><p class="fieldhint" id="noteHint">${a.prompt}</p></details><textarea id="note" aria-describedby="noteHint" oninput="saveNote(${i},this.value)">${esc(c.notes[i]||'')}</textarea><div class="bottom"><button onclick="show(${Math.max(0,i-1)},true)" ${i===0?'disabled':''}>← Previous area</button><button class="primary" onclick="show(${i+1},true)">${i===5?'See this chart’s review':'Next area →'}</button></div>`;}if(focus)document.querySelector(i>=6?'#summary h2':'#detail h2').focus();}
function saveNote(i,s){chart().notes[i]=s;persist();}
function feedback(i,j){let v=chart().answers[i+'-'+j];return !v?'':`<div class="feedback ${v==='attention'?'attention':''}">${v==='yes'?'Documented.':v==='na'?'Add a brief reason in the notes.':areas[i].questions[j][2]}</div>`;}
function answer(k,v){chart().answers[k]=v;persist();refreshAnswer(k);}
function clearAnswer(k){delete chart().answers[k];persist();refreshAnswer(k);}
function refreshAnswer(k){const [i,j]=k.split('-').map(Number);document.querySelectorAll(`[aria-labelledby="q${k}"] button[aria-pressed]`).forEach(b=>b.setAttribute('aria-pressed',b.textContent===labels[chart().answers[k]]));document.getElementById('f'+k).innerHTML=feedback(i,j);updateNav();}
function areaStatus(c,i){const vals=areas[i].questions.map((q,j)=>c.answers[i+'-'+j]);let attention=vals.filter(v=>v==='attention').length,missing=vals.filter(v=>!v).length;return {text:attention?'Needs attention':missing?'Incomplete':vals.every(v=>v==='na')?'Not applicable':'Checked',cls:attention?'attention':missing?'incomplete':'checked',attention,missing};}
function renderSummary(){const c=chart(),counts={yes:0,attention:0,na:0};Object.values(c.answers).forEach(v=>counts[v]++);document.getElementById('summary').innerHTML=`<div class="eyebrow">Chart review</div><h2 tabindex="-1">${esc(c.label)}: next steps</h2><p>${counts.yes} yes · ${counts.attention} need attention · ${counts.na} not applicable · ${total-Object.keys(c.answers).length} unanswered</p><p class="sub">Use this list to identify what needs to be added or clarified in the profile.</p>${areas.map((a,i)=>`<section class="summary-card"><h3>${a.title}</h3>${a.questions.map((q,j)=>`<p><span class="pill">${labels[c.answers[i+'-'+j]]||'Unanswered'}</span> ${q[0]}</p>${c.answers[i+'-'+j]==='attention'?`<p class="small">Next step: ${q[2]}</p>`:''}`).join('')}${c.notes[i]?`<p><strong>Section notes:</strong></p><div class="overview-note">${esc(c.notes[i])}</div>`:''}</section>`).join('')}<div class="toolbar"><button class="primary" onclick="printView()">Print / Save as PDF</button><button onclick="downloadReview()">Download chart review (.txt)</button><button onclick="show(7,true)">Caseload overview</button><button onclick="deleteChart()">Remove this chart</button></div>`;}
function renderOverview(){const need=charts.filter(c=>Object.values(c.answers).includes('attention')).length;document.getElementById('summary').innerHTML=`<div class="eyebrow">All chart reviews</div><h2 tabindex="-1">Caseload overview</h2><p>${charts.length} of 25 charts · ${need} with areas needing attention</p><p class="overview-help small">Needs attention = at least one item needs an update. Incomplete = unanswered items remain. Checked = all items in that area are answered Yes or Not applicable. Click an area to reopen it. Notes appear below.</p><div class="tablewrap"><table><thead><tr><th scope="col">Chart</th>${areas.map(a=>`<th scope="col">${a.title}</th>`).join('')}</tr></thead><tbody>${charts.map((c,n)=>`<tr><th scope="row">${esc(c.label)}<br><small>${Object.keys(c.answers).length}/${total} checked</small></th>${areas.map((a,i)=>{let s=areaStatus(c,i);return `<td class="state-${s.cls}"><button onclick="openArea(${n},${i})">${s.text}</button>${s.missing?`<br><small>${s.missing} unanswered</small>`:''}${c.notes[i]?'<br><small>Has notes</small>':''}</td>`;}).join('')}</tr>`).join('')}</tbody></table></div><h3>Notes and areas to update</h3>${charts.map((c,n)=>`<section class="summary-card"><h3>${esc(c.label)}</h3>${areas.map((a,i)=>{let needs=a.questions.map((q,j)=>c.answers[i+'-'+j]==='attention'?q[0]:null).filter(Boolean);return needs.length||c.notes[i]?`<p><strong>${a.title}</strong></p>${needs.map(q=>`<p>Needs attention: ${q}</p>`).join('')}${c.notes[i]?`<div class="overview-note">${esc(c.notes[i])}</div>`:''}`:''}).join('')||'<p>No areas flagged and no notes yet. Check the table for unanswered items.</p>'}</section>`).join('')}<div class="toolbar"><button class="primary" onclick="printView()">Print overview / Save as PDF</button><button onclick="exportExcel()">Download as Excel spreadsheet</button></div>`;}
function openArea(n,i){active=n;controls();show(i,true);}
function download(text,name,type){const u=URL.createObjectURL(new Blob([text],{type}));const a=document.createElement('a');a.href=u;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);}

async function importBackup(file){if(!file)return;try{const incoming=validate(JSON.parse(await file.text()));if(!confirm('Replace the reviews in this browser with '+incoming.length+' charts from this backup? Use “Save reviews to a file” first if you want to keep your current reviews.'))return;charts=incoming;active=0;persist();controls();show(7,true);}catch(e){alert('Could not restore the reviews. '+e.message);}}

const EXCEL_TEMPLATE={"xl/workbook.xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?><x:workbook xmlns:x=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><x:sheets><x:sheet name=\"Overview\" sheetId=\"1\" r:id=\"R2ff63e1068b3462c\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" /><x:sheet name=\"Section notes\" sheetId=\"2\" r:id=\"R7d0dd11d814f4b22\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" /></x:sheets></x:workbook>", "xl/styles.xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?><x:styleSheet xmlns:x=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><x:fonts count=\"3\"><x:font><x:sz val=\"11\" /><x:name val=\"Carlito\" /></x:font><x:font><x:sz val=\"11\" /><x:color rgb=\"FF243238\" /><x:name val=\"Arial\" /></x:font><x:font><x:b /><x:sz val=\"11\" /><x:color rgb=\"FFFFFFFF\" /><x:name val=\"Arial\" /></x:font></x:fonts><x:fills count=\"3\"><x:fill><x:patternFill patternType=\"none\" /></x:fill><x:fill><x:patternFill patternType=\"gray125\" /></x:fill><x:fill><x:patternFill patternType=\"solid\"><x:fgColor rgb=\"FF245B57\" /></x:patternFill></x:fill></x:fills><x:borders count=\"1\"><x:border><x:left /><x:right /><x:top /><x:bottom /><x:diagonal /></x:border></x:borders><x:cellStyleXfs count=\"1\"><x:xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" /></x:cellStyleXfs><x:cellXfs count=\"6\"><x:xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" /><x:xf numFmtId=\"0\" fontId=\"1\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\" applyFill=\"1\" applyBorder=\"1\" /><x:xf numFmtId=\"0\" fontId=\"1\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\" applyFill=\"1\" applyBorder=\"1\" applyAlignment=\"1\"><x:alignment vertical=\"top\" /></x:xf><x:xf numFmtId=\"0\" fontId=\"1\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\" applyFill=\"1\" applyBorder=\"1\" applyA