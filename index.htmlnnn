=\"str\" /><x:c r=\"B111\" s=\"3\" t=\"str\" /><x:c r=\"C111\" s=\"3\" t=\"str\" /><x:c r=\"D111\" s=\"3\" t=\"str\" /><x:c r=\"E111\" s=\"3\" t=\"str\" /><x:c r=\"F111\" s=\"3\" t=\"str\" /></x:row><x:row r=\"112\" ht=\"90\" customHeight=\"1\"><x:c r=\"A112\" s=\"3\" t=\"str\" /><x:c r=\"B112\" s=\"3\" t=\"str\" /><x:c r=\"C112\" s=\"3\" t=\"str\" /><x:c r=\"D112\" s=\"3\" t=\"str\" /><x:c r=\"E112\" s=\"3\" t=\"str\" /><x:c r=\"F112\" s=\"3\" t=\"str\" /></x:row><x:row r=\"113\" ht=\"90\" customHeight=\"1\"><x:c r=\"A113\" s=\"3\" t=\"str\" /><x:c r=\"B113\" s=\"3\" t=\"str\" /><x:c r=\"C113\" s=\"3\" t=\"str\" /><x:c r=\"D113\" s=\"3\" t=\"str\" /><x:c r=\"E113\" s=\"3\" t=\"str\" /><x:c r=\"F113\" s=\"3\" t=\"str\" /></x:row><x:row r=\"114\" ht=\"90\" customHeight=\"1\"><x:c r=\"A114\" s=\"3\" t=\"str\" /><x:c r=\"B114\" s=\"3\" t=\"str\" /><x:c r=\"C114\" s=\"3\" t=\"str\" /><x:c r=\"D114\" s=\"3\" t=\"str\" /><x:c r=\"E114\" s=\"3\" t=\"str\" /><x:c r=\"F114\" s=\"3\" t=\"str\" /></x:row><x:row r=\"115\" ht=\"90\" customHeight=\"1\"><x:c r=\"A115\" s=\"3\" t=\"str\" /><x:c r=\"B115\" s=\"3\" t=\"str\" /><x:c r=\"C115\" s=\"3\" t=\"str\" /><x:c r=\"D115\" s=\"3\" t=\"str\" /><x:c r=\"E115\" s=\"3\" t=\"str\" /><x:c r=\"F115\" s=\"3\" t=\"str\" /></x:row><x:row r=\"116\" ht=\"90\" customHeight=\"1\"><x:c r=\"A116\" s=\"3\" t=\"str\" /><x:c r=\"B116\" s=\"3\" t=\"str\" /><x:c r=\"C116\" s=\"3\" t=\"str\" /><x:c r=\"D116\" s=\"3\" t=\"str\" /><x:c r=\"E116\" s=\"3\" t=\"str\" /><x:c r=\"F116\" s=\"3\" t=\"str\" /></x:row><x:row r=\"117\" ht=\"90\" customHeight=\"1\"><x:c r=\"A117\" s=\"3\" t=\"str\" /><x:c r=\"B117\" s=\"3\" t=\"str\" /><x:c r=\"C117\" s=\"3\" t=\"str\" /><x:c r=\"D117\" s=\"3\" t=\"str\" /><x:c r=\"E117\" s=\"3\" t=\"str\" /><x:c r=\"F117\" s=\"3\" t=\"str\" /></x:row><x:row r=\"118\" ht=\"90\" customHeight=\"1\"><x:c r=\"A118\" s=\"3\" t=\"str\" /><x:c r=\"B118\" s=\"3\" t=\"str\" /><x:c r=\"C118\" s=\"3\" t=\"str\" /><x:c r=\"D118\" s=\"3\" t=\"str\" /><x:c r=\"E118\" s=\"3\" t=\"str\" /><x:c r=\"F118\" s=\"3\" t=\"str\" /></x:row><x:row r=\"119\" ht=\"90\" customHeight=\"1\"><x:c r=\"A119\" s=\"3\" t=\"str\" /><x:c r=\"B119\" s=\"3\" t=\"str\" /><x:c r=\"C119\" s=\"3\" t=\"str\" /><x:c r=\"D119\" s=\"3\" t=\"str\" /><x:c r=\"E119\" s=\"3\" t=\"str\" /><x:c r=\"F119\" s=\"3\" t=\"str\" /></x:row><x:row r=\"120\" ht=\"90\" customHeight=\"1\"><x:c r=\"A120\" s=\"3\" t=\"str\" /><x:c r=\"B120\" s=\"3\" t=\"str\" /><x:c r=\"C120\" s=\"3\" t=\"str\" /><x:c r=\"D120\" s=\"3\" t=\"str\" /><x:c r=\"E120\" s=\"3\" t=\"str\" /><x:c r=\"F120\" s=\"3\" t=\"str\" /></x:row><x:row r=\"121\" ht=\"90\" customHeight=\"1\"><x:c r=\"A121\" s=\"3\" t=\"str\" /><x:c r=\"B121\" s=\"3\" t=\"str\" /><x:c r=\"C121\" s=\"3\" t=\"str\" /><x:c r=\"D121\" s=\"3\" t=\"str\" /><x:c r=\"E121\" s=\"3\" t=\"str\" /><x:c r=\"F121\" s=\"3\" t=\"str\" /></x:row></x:sheetData><x:pageMargins left=\"0.7\" right=\"0.7\" top=\"0.75\" bottom=\"0.75\" header=\"0.3\" footer=\"0.3\" /></x:worksheet>", "_rels/.rels": "\ufeff<?xml version=\"1.0\" encoding=\"utf-8\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"/xl/workbook.xml\" Id=\"R8ad411285466437a\" /></Relationships>", "xl/_rels/workbook.xml.rels": "\ufeff<?xml version=\"1.0\" encoding=\"utf-8\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"/xl/styles.xml\" Id=\"R77fd7069f78b4f6a\" /><Relationship Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme\" Target=\"/xl/theme/theme1.xml\" Id=\"R4c0596280c2b4cab\" /><Relationship Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings\" Target=\"/xl/sharedStrings.xml\" Id=\"Rc9197f7de0394cc6\" /><Relationship Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"/xl/worksheets/sheet1.xml\" Id=\"R2ff63e1068b3462c\" /><Relationship Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"/xl/worksheets/sheet2.xml\" Id=\"R7d0dd11d814f4b22\" /></Relationships>", "[Content_Types].xml": "\ufeff<?xml version=\"1.0\" encoding=\"utf-8\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\" /><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\" /><Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\" /><Override PartName=\"/xl/theme/theme1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.theme+xml\" /><Override PartName=\"/xl/sharedStrings.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml\" /><Override PartName=\"/xl/worksheets/sheet1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\" /><Override PartName=\"/xl/worksheets/sheet2.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\" /></Types>"};
function xmlText(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[c])).replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g,'');}
function fillExportSheet(source,rows,widths){const templateRows=source.match(/<x:row\b[^>]*>[\s\S]*?<\/x:row>/g)||[];if(rows.length+1>templateRows.length){const sample=templateRows[1];let extra='';for(let r=templateRows.length+1;r<=rows.length+1;r++){extra+=sample.replace(/\br="2"/,'r="'+r+'"').replace(/\br="([A-Z]+)2"/g,(_,col)=>'r="'+col+r+'"');}source=source.replace('</x:sheetData>',extra+'</x:sheetData>');}return source.replace(/<x:row\b[^>]*>[\s\S]*?<\/x:row>/g,row=>{let r=Number(row.match(/\br="(\d+)"/)[1]);if(r===1)return row;if(r>rows.length+1)return '';const vals=rows[r-2];let lines=Math.max(...vals.map((v,i)=>String(v).split('\n').reduce((n,t)=>n+Math.max(1,Math.ceil(t.length/widths[i])),0)));const height=Math.min(409,Math.max(42,lines*16+12));row=row.replace(/\bht="[^"]*"/,'ht="'+height+'"');return row.replace(/<x:c\b[^>]*(?:\/>|>[\s\S]*?<\/x:c>)/g,cell=>{const ref=cell.match(/\br="([A-Z]+)\d+"/)[1];let idx=0;for(const ch of ref)idx=idx*26+ch.charCodeAt(0)-64;const v=vals[idx-1]??'';let tag=cell.match(/^<x:c\b[^>]*?(?=\/?>)/)[0].replace(/\st="[^"]*"/,'');return tag+(typeof v==='number'?'><x:v>'+v+'</x:v></x:c>':' t="inlineStr"><x:is><x:t xml:space="preserve">'+xmlText(v)+'</x:t></x:is></x:c>');});});}
function zipExport(entries){const enc=new TextEncoder(),chunks=[],central=[];let offset=0;function crc32(a){let c=0xFFFFFFFF;for(let b of a){c^=b;for(let k=0;k<8;k++)c=(c>>>1)^((c&1)?0xEDB88320:0);}return (c^0xFFFFFFFF)>>>0;}function header(n){let a=new Uint8Array(n);return [a,new DataView(a.buffer)];}for(const [name,str]of Object.entries(entries)){const n=enc.encode(name),b=enc.encode(str),crc=crc32(b);let [h,v]=header(30);v.setUint32(0,0x04034b50,true);v.setUint16(4,20,true);v.setUint16(6,0x800,true);v.setUint16(12,33,true);v.setUint32(14,crc,true);v.setUint32(18,b.length,true);v.setUint32(22,b.length,true);v.setUint16(26,n.length,true);chunks.push(h,n,b);let [ch,cv]=header(46);cv.setUint32(0,0x02014b50,true);cv.setUint16(4,20,true);cv.setUint16(6,20,true);cv.setUint16(8,0x800,true);cv.setUint16(14,33,true);cv.setUint32(16,crc,true);cv.setUint32(20,b.length,true);cv.setUint32(24,b.length,true);cv.setUint16(28,n.length,true);cv.setUint32(42,offset,true);central.push(ch,n);offset+=h.length+n.length+b.length;}let size=central.reduce((n,a)=>n+a.length,0);let [end,ev]=header(22);ev.setUint32(0,0x06054b50,true);ev.setUint16(8,Object.keys(entries).length,true);ev.setUint16(10,Object.keys(entries).length,true);ev.setUint32(12,size,true);ev.setUint32(16,offset,true);return new Blob([...chunks,...central,end],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});}
function exportExcel(){const entries={...EXCEL_TEMPLATE};let overview=charts.map(c=>[c.label,...areas.map((a,i)=>{const s=areaStatus(c,i);return s.text+(s.missing?' ('+s.missing+' unanswered)':'');})]);let details=[];charts.forEach(c=>areas.forEach((a,i)=>{let s=areaStatus(c,i);details.push([c.label,a.title,s.text,s.missing,a.questions.filter((q,j)=>c.answers[i+'-'+j]==='attention').map(q=>q[0]).join('\n'),c.notes[i]||'']);}));entries['xl/worksheets/sheet1.xml']=fillExportSheet(entries['xl/worksheets/sheet1.xml'],overview,[20,23,23,23,23,23,23]);entries['xl/worksheets/sheet2.xml']=fillExportSheet(entries['xl/worksheets/sheet2.xml'],details,[24,24,24,18,65,65]);download(zipExport(entries),'Career_Profile_Caseload_Overview.xlsx','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');}

function saveReviews(){download(JSON.stringify({version:3,charts},null,2),'Career_Profile_Reviews.json','application/json');}
function downloadReview(){let c=chart(),t='CAREER PROFILE CHECK: '+c.label+'\n\n'+areas.map((a,i)=>a.title+'\n'+a.questions.map((q,j)=>(labels[c.answers[i+'-'+j]]||'Unanswered')+': '+q[0]).join('\n')+'\nNotes: '+(c.notes[i]||'None')+'\n').join('\n');download(t,'Career_Profile_Review.txt','text/plain');}
function deleteChart(){if(!confirm('Remove '+chart().label+' and its answers and notes from this browser?'))return;charts.splice(active,1);if(!charts.length)charts=[blank(1)];active=0;persist();controls();show(7,true);}
function printView(){window.print();}
window.addEventListener('beforeprint',()=>{if(current===7)renderOverview();else renderSummary();});
controls();show(-1);document.getElementById('saveStatus').textContent=storageError||'Saved in this browser only. Initials or chart codes can be used to identify reviews.';
</script></body></html>
